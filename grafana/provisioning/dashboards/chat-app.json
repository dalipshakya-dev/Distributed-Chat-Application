{
  "uid": "chat-app-overview",
  "title": "Chat App Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Redis poll rate per node (polls/sec)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tasks_scheduled_execution_seconds_count{code_function=\"pollStream\"}[1m])",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Kafka assigned partitions per node",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumer_coordinator_assigned_partitions",
          "legendFormat": "{{node}} {{client_id}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Hikari connections in use",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active",
          "legendFormat": "{{node}} active"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_max",
          "legendFormat": "{{node}} max"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP requests per second",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node, status) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{node}} {{status}}"
        }
      ]
    }
  ]
}